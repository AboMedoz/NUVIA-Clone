{
  "name": "nuvia",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs --with-ai",
    "setup:models": "node scripts/setup-models.mjs",
    "test:launcher": "node --test scripts/tests/*.test.mjs",
    "dev:web": "pnpm --filter @nuvia/web dev",
    "dev:network": "pnpm --filter @nuvia/web dev:network",
    "dev:api": "pnpm --filter @nuvia/api dev",
    "dev:backend": "pnpm run dev:api",
    "dev:ai": "node scripts/dev-ai.mjs",
    "setup:local": "pnpm --filter @nuvia/api setup:local",
    "mail:work": "pnpm --filter @nuvia/api mail:work",
    "start:backend": "pnpm --filter @nuvia/api start",
    "db:check": "pnpm --filter @nuvia/api db:check",
    "db:setup": "pnpm --filter @nuvia/api db:setup",
    "build": "pnpm --filter @nuvia/web build",
    "preview": "pnpm --filter @nuvia/web preview",
    "test": "pnpm -r --if-present test",
    "test:web": "pnpm --filter @nuvia/web test",
    "test:backend": "pnpm --filter @nuvia/api test",
    "test:backend:unit": "pnpm --filter @nuvia/api test:unit",
    "test:e2e:accounts": "node tests/e2e/run.mjs",
    "test:e2e:product": "node tests/e2e/product-api.mjs",
    "test:e2e:models": "node tests/e2e/model-service.mjs",
    "test:e2e:invitations": "node tests/e2e/run-invitations.mjs",
    "test:ai": "uv run --directory apps/ai-service pytest",
    "lint": "eslint apps/web/src apps/web/tests apps/api/src apps/api/scripts apps/api/tests packages/shared-types/src scripts tests/e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "pnpm --filter @nuvia/web test:watch",
    "previews": "pnpm --filter @nuvia/web previews",
    "screenshots": "pnpm --filter @nuvia/web screenshots"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "vite": "7.3.7",
    "playwright": "1.62.1",
    "mongodb-memory-server-core": "11.3.0"
  }
}
